{
  "name": "@platforma-open/milaboratories.software-mixcr",
  "version": "1.0.0",
  "description": "MiXCR software dependency for Platforma Backend",
  "scripts": {
    "build": "true",
    "postinstall": "node ./scripts/unpack-ci.js",
    "prepublishOnly": "pl-pkg build && pl-pkg prepublish"
  },
  "block-software": {
    "entrypoints": {
      "main": {
        "binary": {
          "artifact": {
            "registry": "milaboratories",
            "name": "milaboratories/mixcr",
            "type": "java",
            "environment": "@platforma-open/milaboratories.runenv-java-corretto:21.0.2.13.1",
            "root": "./dld/mixcr/"
          },
          "cmd": [
            "java",
            "-XX:MaxRAMPercentage=80.0",
            "-XX:MaxHeapFreeRatio=10",
            "-XX:MinHeapFreeRatio=2",
            "-jar",
            "{pkg}/mixcr.jar"
          ]
        },
        "docker": {
          "artifact": {
            "type": "docker",
            "context": "./dld/mixcr/"
          },
          "cmd": [
            "java",
            "-XX:MaxRAMPercentage=80.0",
            "-XX:MaxHeapFreeRatio=10",
            "-XX:MinHeapFreeRatio=2",
            "-jar",
            "/app/mixcr.jar"
          ]
        }
      },
      "low-memory": {
        "binary": {
          "artifact": {
            "registry": "milaboratories",
            "name": "milaboratories/mixcr",
            "type": "java",
            "environment": "@platforma-open/milaboratories.runenv-java-corretto:21.0.2.13.1",
            "root": "./dld/mixcr/"
          },
          "cmd": [
            "java",
            "-Xmx8g",
            "-jar",
            "{pkg}/mixcr.jar"
          ]
        },
        "docker": {
          "artifact": {
            "type": "docker",
            "context": "./dld/mixcr/"
          },
          "cmd": [
            "java",
            "-Xmx8g",
            "-jar",
            "/app/mixcr.jar"
          ]
        }
      },
      "memory-from-limits": {
        "binary": {
          "artifact": {
            "registry": "milaboratories",
            "name": "milaboratories/mixcr",
            "type": "java",
            "environment": "@platforma-open/milaboratories.runenv-java-corretto:21.0.2.13.1",
            "root": "./dld/mixcr/"
          },
          "cmd": [
            "java",
            "-Xms{int(((((system.ram.mib*91/100)+(system.ram.mib-2000)-abs((system.ram.mib*91/100)-(system.ram.mib-2000)))/2)+(system.ram.mib*50/100)+abs((((system.ram.mib*91/100)+(system.ram.mib-2000)-abs((system.ram.mib*91/100)-(system.ram.mib-2000)))/2)-(system.ram.mib*50/100)))/2)}m",
            "-XX:MaxHeapFreeRatio=10",
            "-XX:MinHeapFreeRatio=2",
            "-jar",
            "{pkg}/mixcr.jar"
          ]
        },
        "docker": {
          "artifact": {
            "type": "docker",
            "context": "./dld/mixcr/"
          },
          "cmd": [
            "java",
            "-Xms{int(((((system.ram.mib*91/100)+(system.ram.mib-2000)-abs((system.ram.mib*91/100)-(system.ram.mib-2000)))/2)+(system.ram.mib*50/100)+abs((((system.ram.mib*91/100)+(system.ram.mib-2000)-abs((system.ram.mib*91/100)-(system.ram.mib-2000)))/2)-(system.ram.mib*50/100)))/2)}m",
            "-XX:MaxHeapFreeRatio=10",
            "-XX:MinHeapFreeRatio=2",
            "-jar",
            "/app/mixcr.jar"
          ]
        }
      }
    }
  },
  "files": [
    "dist/",
    "scripts/unpack-ci.js"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@platforma-sdk/package-builder": "^3.2.3",
    "@platforma-open/milaboratories.runenv-java-corretto": "^1.1.5",
    "unzipper": "^0.12.3"
  }
}
